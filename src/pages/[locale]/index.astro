---
import Site from '../../layouts/Site.astro'
import ServiceCards from '../../components/ServiceCards.astro'
import FAQ from '../../components/FAQ.astro'
import Icon from '../../components/Icon.astro'
import {isLive, locales, pick, url} from '../../lib/content'
import {editorial} from '../../lib/cms'
export const getStaticPaths = () => locales.map(locale => ({params:{locale}, props:{locale}}))
const {locale} = Astro.props
const {pages, faqs, settings} = await editorial(locale)
const page = pages.find(item => item.slug === 'home')
const c = (en:string, ar:string) => pick(locale,[en,ar])
if (isLive() && (!page?.title || !page.intro || !page.serviceApproved)) throw new Error('Approve home copy and promoted services before release.')
const description = page?.intro || c('Company formation, licensing and corporate PRO support for entrepreneurs and growing businesses across the Emirates.','دعم تأسيس الشركات والتراخيص والمعاملات الحكومية لرواد الأعمال والشركات النامية في الإمارات.')
---
<Site locale={locale} title={page?.seoTitle || c('UAE business setup','تأسيس الأعمال في الإمارات')} description={page?.seoDescription || description} whatsapp={settings?.whatsapp}>
  <section class="hero">
    <img src="/images/dubai.webp" alt="" class="hero-image" width="1774" height="887" fetchpriority="high" />
    <div class="shell hero-content">
      <div class="eyebrow"><span></span>{c('UAE BUSINESS SETUP & PRO SERVICES','تأسيس الأعمال والمعاملات الحكومية في الإمارات')}</div>
      <h1>{page?.title || <>{c('Build your business','أسّس أعمالك')}<br /><em>{c('in the UAE.','في الإمارات.')}</em></>}</h1>
      <p>{description}</p>
      <div class="hero-actions">
        <a class="btn btn-gold" href={url(locale,'contact')}>{c('Book a Free Consultation','احجز استشارة مجانية')} <Icon name="diagonal" size={18} /></a>
        <a class="btn btn-outline" href={url(locale,'setup-quiz')}>{c('Find Your Setup Route','اكتشف مسار التأسيس')} <Icon name="arrow" size={18} /></a>
      </div>
    </div>
  </section>
  <section class="section services" id="services">
    <div class="shell">
      <div class="section-row">
        <div><div class="eyebrow dark"><span></span>{c('OUR SERVICES','خدماتنا')}</div>
        <h2>{c('Support at every stage.','دعم في كل مرحلة.')}</h2>
        <p>{c('From choosing a setup route to managing day-to-day requirements.', 'من اختيار مسار التأسيس إلى إدارة المتطلبات اليومية.')}</p></div>
        <a class="text-link" href={url(locale,'business-setup')}>{c('View all services','عرض جميع الخدمات')} <Icon name="diagonal" size={18} /></a>
      </div>
      {!isLive() && <p class="draft">{c('Proposed services · Pending confirmation','خدمات مقترحة · بانتظار التأكيد')}</p>}
      <ServiceCards locale={locale} editorialPages={pages} />
    </div>
  </section>
  <section class="section process">
    <div class="shell">
      <div class="eyebrow dark"><span></span>{c('HOW IT WORKS','كيف نعمل')}</div>
      <h2>{c('From idea to next steps.','من الفكرة إلى الخطوات التالية.')}</h2>
      <div class="process-grid">
        {[
          [c('Share your business goals','شارك أهداف أعمالك'),c('Tell us about your activity and where you plan to operate.','أخبرنا عن نشاطك ومكان التشغيل الذي تفضله.')],
          [c('Compare your options','قارن خياراتك'),c('Discuss the setup routes and requirements relevant to your plans.','ناقش مسارات التأسيس والمتطلبات المرتبطة بخططك.')],
          [c('Agree on the next steps','اتفق على الخطوات التالية'),c('Clarify the scope of support before moving forward.','وضّح نطاق الدعم قبل المضي قدمًا.')],
        ].map(([heading,body],i) => <div><span class="step">{String(i+1).padStart(2,'0')}</span><h3>{heading}</h3><p>{body}</p></div>)}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="shell faq-grid"><div><h2>{c('Common questions','أسئلة شائعة')}</h2><a class="text-link" href={url(locale,'faq')}>{c('View FAQs','عرض الأسئلة الشائعة')} <Icon name="arrow" size={18} /></a></div><FAQ locale={locale} entries={faqs} /></div>
  </section>
  <section class="contact-band"><div class="shell section-row"><h2>{c('Let’s discuss your business plans.','لنتحدث عن خطط أعمالك.')}</h2><a class="btn btn-gold" href={url(locale,'contact')}>{c('Request a Consultation','اطلب استشارة')} <Icon name="diagonal" size={18} /></a></div></section>
</Site>
